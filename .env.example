# Direct mode: clients call Groq with their own key.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Client mode: point at a hosted backend so users need no Groq key.
# AI_REVIEW_API_URL=http://your-host:8000
# AI_REVIEW_API_TOKEN=shared-client-token

# Server-side settings (ai-review-server).
# AI_REVIEW_HOST=0.0.0.0
# AI_REVIEW_PORT=8000
